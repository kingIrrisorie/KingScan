@model frontend.Models.Manga

@{
	Manga manga = Model;
}

<p><img src="@manga.ThumbnailURL" alt="thumb de berserk" /></p>
<h1>@manga.Title</h1>
<span>@manga.Status</span>
<p><br />@manga.Description</p>
<p>@manga.Released</p>
<p>autor: @manga.AuthorName</p>

<p>
	generos: @foreach (string gender in manga.GenreNames)
	{
		<span>@gender </span>
	}
</p>

@manga.