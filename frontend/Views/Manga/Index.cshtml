@model frontend.Models.Manga

@{
	Manga manga = Model;
}

<span>id: @manga.Id</span>
<h1>@manga.Title</h1>
<span>status: @manga.Status</span>
<p>description:<br />@manga.Description</p>
<p>lancamento: @manga.Released</p>
<p>thumbnail: @manga.ThumbnailURL</p>
<p>autor: @manga.AuthorName</p>

<p>
	generos: @foreach (string gender in manga.GenreNames)
	{
		<span>@gender </span>
	}
</p>

